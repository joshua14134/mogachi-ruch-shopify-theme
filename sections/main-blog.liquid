<section class="section"><div class="container">
  <div class="section__heading"><div class="eyebrow">GOAN FOOD GUIDE</div><h1>{{ blog.title }}</h1></div>
  <div class="grid grid--3">
    {% for article in blog.articles %}
      <a class="card" href="{{ article.url }}">
        {% if article.image %}{{ article.image | image_url: width:900 | image_tag: loading:'lazy', alt:article.title }}{% else %}<div class="placeholder">Goan Food Guide</div>{% endif %}
        <div class="card__body"><h2 class="card__title">{{ article.title }}</h2><p class="card__text">{{ article.excerpt_or_content | strip_html | truncate:130 }}</p></div>
      </a>
    {% endfor %}
  </div>
</div></section>
{% schema %}{"name":"Main blog","settings":[]}{% endschema %}
