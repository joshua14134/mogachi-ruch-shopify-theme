<section class="section mr-business"><div class="container"><div class="eyebrow">BUSINESS</div><h2>{{ section.settings.heading }}</h2><div class="mr-business__grid">{% for block in section.blocks %}<article {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p><a href="{{ block.settings.url }}">{{ block.settings.label }}</a></article>{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Business links",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Mogachi Ruch for business"
    }
  ],
  "blocks": [
    {
      "type": "business",
      "name": "Business link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Corporate Gifting"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Create thoughtful food gifts for teams, clients and celebrations."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Business links",
      "blocks": [
        {
          "type": "business"
        },
        {
          "type": "business"
        },
        {
          "type": "business"
        }
      ]
    }
  ]
}
{% endschema %}
