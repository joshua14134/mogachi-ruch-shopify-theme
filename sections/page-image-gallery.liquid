<section class="page-image-gallery section-pad">
  <div class="container">
    <div class="page-image-gallery__intro">
      <span class="eyebrow">MOGACHI RUCH</span>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}
    </div>
    <div class="page-image-gallery__grid">
      {% if section.blocks.size > 0 %}{% for block in section.blocks %}
        {% assign image = block.settings.image %}
        <a class="page-image-gallery__card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          {% if image != blank %}
            <img src="{{ image | image_url: width: 1000 }}" alt="{{ image.alt | escape }}" loading="lazy" width="1000" height="750">
          {% else %}
            {% assign fallback = block.settings.fallback | default: 'goan-flavours.svg' %}
            <img src="{{ fallback | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="1000" height="750">
          {% endif %}
          <div class="page-image-gallery__overlay">
            <h3>{{ block.settings.title }}</h3>
            {% if block.settings.caption != blank %}<p>{{ block.settings.caption }}</p>{% endif %}
          </div>
        </a>
      {% endfor %}{% else %}<a class="page-image-gallery__card" href="/pages/shop"><img src="{{ 'goan-flavours.svg' | asset_url }}" alt="Goan flavours"><div class="page-image-gallery__overlay"><h3>Goan Flavours</h3><p>Masalas, pickles, sweets and traditional favourites.</p></div></a><a class="page-image-gallery__card" href="/pages/our-story"><img src="{{ 'goan-story.svg' | asset_url }}" alt="Mogachi Ruch story"><div class="page-image-gallery__overlay"><h3>Our Story</h3><p>Discover the ideas and traditions behind Mogachi Ruch.</p></div></a><a class="page-image-gallery__card" href="/pages/gifts"><img src="{{ 'goan-gifts.svg' | asset_url }}" alt="Goan gifts"><div class="page-image-gallery__overlay"><h3>Gifts From Goa</h3><p>Thoughtful food gifts for every occasion.</p></div></a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page image gallery",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A taste of Goa" },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "Explore the flavours, stories and traditions behind Mogachi Ruch." }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Goan Flavours" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Traditional taste, beautifully presented." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "fallback", "label": "Fallback asset", "default": "goan-flavours.svg" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Page image gallery",
      "blocks": [
        { "type": "image", "settings": { "title": "Goan Flavours", "caption": "Masalas, pickles and traditional favourites.", "fallback": "goan-flavours.svg" } },
        { "type": "image", "settings": { "title": "Made With Tradition", "caption": "Stories and recipes from Goa.", "fallback": "goan-story.svg" } },
        { "type": "image", "settings": { "title": "Gifts From Goa", "caption": "Thoughtful boxes for every occasion.", "fallback": "goan-gifts.svg" } }
      ]
    }
  ]
}
{% endschema %}
