<section class="pr-trust">
  {% for block in section.blocks %}
    <div class="pr-trust__item" {{ block.shopify_attributes }}>
      <span class="pr-trust__icon">{{ block.settings.icon }}</span>
      <strong>{{ block.settings.title }}</strong>
      <small>{{ block.settings.text }}</small>
    </div>
  {% endfor %}
</section>
