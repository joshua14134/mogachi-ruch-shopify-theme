<section class="mr-address-page">
  <div class="mr-address-shell">

    <div class="mr-address-top">
      <div>
        <span class="mr-address-eyebrow">ACCOUNT</span>
        <h1>My Addresses</h1>
        <p>Save and manage your delivery addresses for faster checkout.</p>
      </div>

      <a href="{{ routes.account_url }}" class="mr-address-back">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 12H5"></path>
          <path d="M11 18l-6-6 6-6"></path>
        </svg>
        <span>My Account</span>
      </a>
    </div>

    <div class="mr-address-layout">

      <main class="mr-address-main">

        <div class="mr-address-heading">
          <div>
            <span class="mr-section-label">DELIVERY</span>
            <h2>Saved Addresses</h2>
          </div>

          <span class="mr-address-count">
            {{ customer.addresses_count }}
            {% if customer.addresses_count == 1 %}
              Address
            {% else %}
              Addresses
            {% endif %}
          </span>
        </div>

        {% if customer.addresses_count > 0 %}

          <div class="mr-address-grid">

            {% for address in customer.addresses %}

              <article class="mr-address-card">

                <div class="mr-address-card-top">

                  <div class="mr-address-card-title">

                    <div class="mr-address-icon">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12z"></path>
                        <circle cx="12" cy="9" r="2.3"></circle>
                      </svg>
                    </div>

                    <div>
                      <span>DELIVERY ADDRESS</span>

                      {% if address.first_name != blank or address.last_name != blank %}
                        <h3>
                          {{ address.first_name | escape }}
                          {{ address.last_name | escape }}
                        </h3>
                      {% else %}
                        <h3>Saved Address</h3>
                      {% endif %}
                    </div>

                  </div>

                  {% if address == customer.default_address %}
                    <span class="mr-default-badge">DEFAULT</span>
                  {% endif %}

                </div>

                <div class="mr-address-details">
                  {{ address | format_address }}
                </div>

                <div class="mr-address-card-bottom">

                  <a
                    href="/account/addresses/{{ address.id }}"
                    class="mr-address-edit"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 20h9"></path>
                      <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z"></path>
                    </svg>
                    <span>Edit Address</span>
                  </a>

                  <form
                    method="post"
                    action="/account/addresses/{{ address.id }}"
                    onsubmit="return confirm('Are you sure you want to delete this address?');"
                  >
                    <input
                      type="hidden"
                      name="_method"
                      value="delete"
                    >

                    <button
                      type="submit"
                      class="mr-address-delete"
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 7h16"></path>
                        <path d="M10 11v6"></path>
                        <path d="M14 11v6"></path>
                        <path d="M6 7l1 14h10l1-14"></path>
                        <path d="M9 7V4h6v3"></path>
                      </svg>
                      <span>Delete</span>
                    </button>
                  </form>

                </div>

              </article>

            {% endfor %}

          </div>

        {% else %}

          <div class="mr-address-empty">

            <div class="mr-empty-address-icon">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12z"></path>
                <circle cx="12" cy="9" r="2.3"></circle>
              </svg>
            </div>

            <span class="mr-section-label">NO SAVED ADDRESSES</span>

            <h3>Add your first delivery address</h3>

            <p>
              Save an address here so you can check out faster the next time you shop with Mogachi Ruch.
            </p>

          </div>

        {% endif %}

        <div class="mr-new-address-section">

          <div class="mr-new-address-heading">
            <div>
              <span class="mr-section-label">NEW ADDRESS</span>
              <h2>Add a delivery address</h2>
            </div>
          </div>

          {% form 'customer_address', customer.new_address %}

            {% if form.errors %}
              <div class="mr-form-errors">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <div class="mr-address-form-grid">

              <div class="mr-form-field">
                <label for="AddressFirstName">First Name</label>
                <input
                  id="AddressFirstName"
                  type="text"
                  name="address[first_name]"
                  value="{{ form.first_name }}"
                  autocomplete="given-name"
                  placeholder="First name"
                >
              </div>

              <div class="mr-form-field">
                <label for="AddressLastName">Last Name</label>
                <input
                  id="AddressLastName"
                  type="text"
                  name="address[last_name]"
                  value="{{ form.last_name }}"
                  autocomplete="family-name"
                  placeholder="Last name"
                >
              </div>

              <div class="mr-form-field mr-form-full">
                <label for="AddressCompany">Company</label>
                <input
                  id="AddressCompany"
                  type="text"
                  name="address[company]"
                  value="{{ form.company }}"
                  autocomplete="organization"
                  placeholder="Company name"
                >
              </div>

              <div class="mr-form-field mr-form-full">
                <label for="AddressAddress1">Address</label>
                <input
                  id="AddressAddress1"
                  type="text"
                  name="address[address1]"
                  value="{{ form.address1 }}"
                  autocomplete="address-line1"
                  placeholder="House number, street, area"
                  required
                >
              </div>

              <div class="mr-form-field mr-form-full">
                <label for="AddressAddress2">Apartment / Landmark</label>
                <input
                  id="AddressAddress2"
                  type="text"
                  name="address[address2]"
                  value="{{ form.address2 }}"
                  autocomplete="address-line2"
                  placeholder="Apartment, landmark, etc."
                >
              </div>

              <div class="mr-form-field">
                <label for="AddressCity">City</label>
                <input
                  id="AddressCity"
                  type="text"
                  name="address[city]"
                  value="{{ form.city }}"
                  autocomplete="address-level2"
                  placeholder="City"
                  required
                >
              </div>

              <div class="mr-form-field">
                <label for="AddressZip">PIN Code</label>
                <input
                  id="AddressZip"
                  type="text"
                  name="address[zip]"
                  value="{{ form.zip }}"
                  autocomplete="postal-code"
                  placeholder="PIN code"
                  inputmode="numeric"
                  required
                >
              </div>

              <div class="mr-form-field">
                <label for="AddressCountry">Country</label>
                <select
                  id="AddressCountry"
                  name="address[country]"
                  data-default="{{ form.country }}"
                  autocomplete="country"
                >
                  {{ all_country_option_tags }}
                </select>
              </div>

              <div class="mr-form-field">
                <label for="AddressProvince">State</label>
                <select
                  id="AddressProvince"
                  name="address[province]"
                  data-default="{{ form.province }}"
                  autocomplete="address-level1"
                >
                  <option value="">Select state</option>
                </select>
              </div>

              <div class="mr-form-field mr-form-full">
                <label for="AddressPhone">Phone</label>
                <input
                  id="AddressPhone"
                  type="tel"
                  name="address[phone]"
                  value="{{ form.phone }}"
                  autocomplete="tel"
                  placeholder="Phone number"
                >
              </div>

              <div class="mr-form-checkbox mr-form-full">
                <input
                  id="AddressDefault"
                  type="checkbox"
                  name="address[default]"
                  value="1"
                >
                <label for="AddressDefault">
                  Set this as my default delivery address
                </label>
              </div>

            </div>

            <div class="mr-address-form-actions">

              <button type="submit" class="mr-primary-button">
                <span>Save Address</span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h14"></path>
                  <path d="M13 6l6 6-6 6"></path>
                </svg>
              </button>

              <a
                href="{{ routes.account_url }}"
                class="mr-secondary-button"
              >
                Cancel
              </a>

            </div>

          {% endform %}

        </div>

      </main>

      <aside class="mr-address-sidebar">

        <div class="mr-address-sidebar-card">

          <div class="mr-sidebar-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 6L9 17l-5-5"></path>
            </svg>
          </div>

          <span class="mr-section-label">YOUR DETAILS</span>

          <h3>Keep your delivery information ready.</h3>

          <p>
            Adding an address makes checkout quicker and helps keep your orders organized.
          </p>

        </div>

        <a
          href="{{ routes.all_products_collection_url }}"
          class="mr-sidebar-shop"
        >
          <span>Shop Mogachi Ruch</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="M13 6l6 6-6 6"></path>
          </svg>
        </a>

      </aside>

    </div>

  </div>
</section>

