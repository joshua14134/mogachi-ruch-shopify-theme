<script>
(function() {
  var countrySelect = document.getElementById('AddressCountry');
  var provinceSelect = document.getElementById('AddressProvince');

  if (!countrySelect || !provinceSelect) {
    return;
  }

  function updateProvinceOptions() {
    var selectedOption = countrySelect.options[countrySelect.selectedIndex];

    if (!selectedOption) {
      return;
    }

    var provinces = selectedOption.getAttribute('data-provinces');
    var defaultProvince = provinceSelect.getAttribute('data-default');

    provinceSelect.innerHTML = '';

    if (!provinces) {
      var emptyOption = document.createElement('option');
      emptyOption.value = '';
      emptyOption.textContent = 'State / Province';
      provinceSelect.appendChild(emptyOption);
      return;
    }

    try {
      var provinceData = JSON.parse(provinces);

      if (!provinceData.length) {
        var noProvinceOption = document.createElement('option');
        noProvinceOption.value = '';
        noProvinceOption.textContent = 'State / Province';
        provinceSelect.appendChild(noProvinceOption);
        return;
      }

      provinceData.forEach(function(province) {
        var option = document.createElement('option');
        option.value = province[0];
        option.textContent = province[1];

        if (option.value === defaultProvince) {
          option.selected = true;
        }

        provinceSelect.appendChild(option);
      });

    } catch (error) {
      var fallbackOption = document.createElement('option');
      fallbackOption.value = '';
      fallbackOption.textContent = 'State / Province';
      provinceSelect.appendChild(fallbackOption);
    }
  }

  countrySelect.addEventListener('change', updateProvinceOptions);
  updateProvinceOptions();
})();
</script>

