<section class="section mr-contact"><div class="container"><div class="mr-contact__intro"><div class="eyebrow">GET IN TOUCH</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>{% form 'contact', class: 'mr-contact-form' %}<div class="mr-form-grid"><label>Name<input type="text" name="contact[name]" required></label><label>Email<input type="email" name="contact[email]" required></label></div><label>Phone<input type="tel" name="contact[phone]"></label><label>Message<textarea name="contact[body]" rows="7" required></textarea></label><button class="btn" type="submit">SEND MESSAGE</button>{% if form.posted_successfully? %}<p>Thanks. Your message has been sent.</p>{% endif %}{% if form.errors %}<div>{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</div></section>{% schema %}{"name":"Contact form","settings":[{"type":"text","id":"heading","label":"Heading","default":"Contact Mogachi Ruch"},{"type":"textarea","id":"text","label":"Text","default":"Have a question about products, orders, gifting or availability? Send us a message."}]}{% endschema %}