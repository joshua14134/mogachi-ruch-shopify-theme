<section class="mr-section"><div class="page-width"><div class="mr-video"><h2>{{ section.settings.heading }}</h2>{% if section.settings.video_url != blank %}<a href="{{ section.settings.video_url }}" target="_blank" rel="noopener">Watch video</a>{% endif %}</div></div></section>
{% schema %}
{
  "name": "Video",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The taste of Goa"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL"
    }
  ],
  "presets": [
    {
      "name": "Video"
    }
  ]
}
{% endschema %}
