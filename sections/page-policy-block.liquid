<section class="section mr-policy"><div class="container"><div class="eyebrow">MOGACHI RUCH</div><h2>{{ section.settings.heading }}</h2><div class="mr-policy__grid"><div class="rte">{{ section.settings.content }}</div><div class="mr-policy__side"><strong>Need help?</strong><p>For questions about orders, delivery, products or policies, contact Mogachi Ruch.</p><a class="btn" href="/pages/contact">CONTACT US</a></div></div></div></section>
{% schema %}
{
  "name": "Policy content",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Store information"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Please review the information on this page before placing an order. Replace this copy with your final business policy where required.</p><p>Product labels and the information supplied with the actual product remain the definitive source for ingredients, allergens, storage and shelf-life details.</p>"
    }
  ],
  "presets": [
    {
      "name": "Policy content"
    }
  ]
}
{% endschema %}
