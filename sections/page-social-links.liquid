<section class="mr-section"><div class="page-width"><h2>{{ section.settings.heading }}</h2><div class="mr-links">{% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}">Instagram</a>{% endif %}{% if section.settings.facebook != blank %}<a href="{{ section.settings.facebook }}">Facebook</a>{% endif %}{% if section.settings.youtube != blank %}<a href="{{ section.settings.youtube }}">YouTube</a>{% endif %}</div></div></section>
{% schema %}
{
  "name": "Social Links",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow Mogachi Ruch"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "youtube",
      "label": "YouTube"
    }
  ],
  "presets": [
    {
      "name": "Social Links"
    }
  ]
}
{% endschema %}
