<section class="mr-password-page">
  <div class="mr-password-page__inner">

    <div class="mr-password-brand">
      <span>MOGACHI</span>
      <small>RUCH</small>
    </div>

    <div class="mr-password-card">

      <div class="mr-password-eyebrow">
        MOGACHI RUCH
      </div>

      <h1>Opening soon</h1>

      <p class="mr-password-intro">
        Our kitchen is getting ready. Enter the password to visit our store.
      </p>

      {% form 'storefront_password', class: 'mr-password-form' %}

        {% if form.errors %}
          <div class="mr-password-error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <label for="StorefrontPassword">
          Store password
        </label>

        <div class="mr-password-input-row">
          <input
            type="password"
            name="password"
            id="StorefrontPassword"
            autocomplete="current-password"
            placeholder="Enter store password"
            required
          >

          <button type="submit">
            Enter Store
          </button>
        </div>

      {% endform %}

      {% unless shop.password_message == blank %}
        <div class="mr-password-message">
          {{ shop.password_message }}
        </div>
      {% endunless %}

      <a class="mr-password-home" href="{{ routes.root_url }}">
        Back to store
      </a>

    </div>

  </div>
</section>

<style>
.mr-password-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f2e9;
  padding: 70px 24px;
  box-sizing: border-box;
}

.mr-password-page__inner {
  width: 100%;
  max-width: 760px;
  text-align: center;
}

.mr-password-brand {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 42px;
  color: #17351f;
  line-height: .9;
}

.mr-password-brand span {
  font-size: 27px;
  font-weight: 900;
  letter-spacing: .16em;
}

.mr-password-brand small {
  margin-top: 7px;
  color: #9d6255;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .42em;
}

.mr-password-card {
  width: 100%;
  box-sizing: border-box;
  padding: 55px 58px 50px;
  background: #ffffff;
  border: 1px solid #e8e0d4;
  box-shadow: 0 20px 60px rgba(23,53,31,.08);
}

.mr-password-eyebrow {
  margin-bottom: 18px;
  color: #8f594c;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .2em;
}

.mr-password-card h1 {
  margin: 0;
  color: #17351f;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(46px, 6vw, 72px);
  font-weight: 400;
  line-height: 1;
  letter-spacing: -.025em;
}

.mr-password-intro {
  max-width: 560px;
  margin: 24px auto 38px;
  color: #526257;
  font-size: 17px;
  line-height: 1.6;
}

.mr-password-form {
  width: 100%;
  text-align: left;
}

.mr-password-form label {
  display: block;
  margin: 0 0 10px;
  color: #17351f;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: .04em;
}

.mr-password-input-row {
  display: flex;
  width: 100%;
  gap: 10px;
}

.mr-password-input-row input {
  flex: 1 1 auto;
  min-width: 0;
  height: 56px;
  padding: 0 18px;
  box-sizing: border-box;
  border: 1px solid #d8d2c8;
  border-radius: 0;
  background: #fff;
  color: #17351f;
  font-size: 16px;
  outline: none;
}

.mr-password-input-row input:focus {
  border-color: #17351f;
  box-shadow: 0 0 0 2px rgba(23,53,31,.08);
}

.mr-password-input-row button {
  flex: 0 0 auto;
  height: 56px;
  padding: 0 27px;
  border: 0;
  border-radius: 0;
  background: #17351f;
  color: #fff;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background .2s ease, transform .2s ease;
}

.mr-password-input-row button:hover {
  background: #2f7d32;
  transform: translateY(-1px);
}

.mr-password-error {
  margin: 0 0 18px;
  padding: 12px 15px;
  background: #f8e7e3;
  border: 1px solid #e4c4bd;
  color: #8d3f34;
  font-size: 14px;
  line-height: 1.5;
}

.mr-password-message {
  max-width: 560px;
  margin: 25px auto 0;
  color: #68756c;
  font-size: 14px;
  line-height: 1.6;
}

.mr-password-home {
  display: inline-block;
  margin-top: 28px;
  color: #17351f;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: .06em;
  text-decoration: none;
  border-bottom: 1px solid #17351f;
  padding-bottom: 3px;
}

.mr-password-home:hover {
  color: #2f7d32;
  border-color: #2f7d32;
}

@media screen and (max-width: 650px) {
  .mr-password-page {
    padding: 45px 18px;
  }

  .mr-password-brand {
    margin-bottom: 30px;
  }

  .mr-password-brand span {
    font-size: 22px;
  }

  .mr-password-card {
    padding: 40px 22px 35px;
  }

  .mr-password-card h1 {
    font-size: 48px;
  }

  .mr-password-intro {
    font-size: 15px;
    margin-bottom: 30px;
  }

  .mr-password-input-row {
    flex-direction: column;
  }

  .mr-password-input-row input,
  .mr-password-input-row button {
    width: 100%;
    height: 54px;
  }
}
</style>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}