<section class="section"><div class="container contact-page"><div class="section__heading"><div class="eyebrow">GET IN TOUCH</div><h1>{{ section.settings.heading }}</h1><p>{{ section.settings.text }}</p></div><div class="contact-grid"><div class="contact-card"><h3>{{ section.settings.side_heading }}</h3><p>{{ section.settings.side_text }}</p><div class="contact-details"><p><strong>Email</strong><br>{{ section.settings.email }}</p><p><strong>Phone</strong><br>{{ section.settings.phone }}</p><p><strong>Hours</strong><br>{{ section.settings.hours }}</p></div></div><div class="contact-card"><form method="post" action="/contact#ContactForm" id="ContactForm"><input type="hidden" name="form_type" value="contact"><input type="hidden" name="utf8" value="✓"><label>Name<input type="text" name="contact[name]" required></label><label>Email<input type="email" name="contact[email]" required></label><label>Phone<input type="tel" name="contact[phone]"></label><label>Message<textarea name="contact[body]" rows="6" required></textarea></label><button class="button" type="submit">{{ section.settings.button }}</button></form></div></div></div></section>
<style>.contact-page{max-width:1100px}.contact-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:24px}.contact-card{background:var(--card);border:1px solid var(--border);border-radius:24px;padding:32px}.contact-details{margin-top:28px;display:grid;gap:12px}.contact-card form{display:grid;gap:16px}.contact-card label{display:grid;gap:7px;font-weight:600}.contact-card input,.contact-card textarea{width:100%;border:1px solid var(--border);background:var(--bg);padding:13px 14px;border-radius:10px;font:inherit}.contact-card textarea{resize:vertical}@media(max-width:700px){.contact-grid{grid-template-columns:1fr}.contact-card{padding:22px}}</style>
{% schema %}{"name":"Contact page","settings":[{"type":"text","id":"heading","label":"Heading","default":"We'd love to hear from you"},{"type":"textarea","id":"text","label":"Intro","default":"Questions about our products, orders or Goan flavours? Send us a message."},{"type":"text","id":"side_heading","label":"Side heading","default":"Mogachi Ruch"},{"type":"textarea","id":"side_text","label":"Side text","default":"Bring the taste of traditional Goa to your table."},{"type":"text","id":"email","label":"Email","default":"Use the contact form for customer care"},{"type":"text","id":"phone","label":"Phone","default":"Send your order number through the form"},{"type":"text","id":"hours","label":"Hours","default":"Customer enquiries are handled through the contact form"},{"type":"text","id":"button","label":"Button","default":"Send message"}],"presets":[{"name":"Contact page"}]}{% endschema %}
