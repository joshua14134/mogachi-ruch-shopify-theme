<section class="hero-slider" data-slider data-autoplay="{{ section.settings.autoplay | times: 1000 }}">
  <div class="hero-slider__track" data-slider-track>
    {% for block in section.blocks %}
      <article class="hero-slide" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 2200 | image_tag: loading: forloop.first | default: 'eager', alt: block.settings.heading }}
        {% else %}
          <img class="hero-slide__placeholder" src="{{ 'goan-flavours.svg' | asset_url }}" alt="Goan flavours" width="2200" height="1400">
        {% endif %}
        <div class="hero-slide__shade"></div>
        <div class="container hero-slide__inner">
          <div class="hero-slide__copy">
            {% if block.settings.eyebrow != blank %}<span class="hero-slide__eyebrow">{{ block.settings.eyebrow }}</span>{% endif %}
            <h1>{{ block.settings.heading }}</h1>
            {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
            <div class="hero-slide__actions">
              {% if block.settings.button_label != blank %}<a class="btn btn--light" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>{% endif %}
              {% if block.settings.secondary_label != blank %}<a class="hero-slide__secondary" href="{{ block.settings.secondary_link }}">{{ block.settings.secondary_label }} <span>↗</span></a>{% endif %}
            </div>
          </div>
          {% if block.settings.card_title != blank %}
            <div class="hero-slide__card">
              <span>{{ block.settings.card_kicker }}</span><strong>{{ block.settings.card_title }}</strong><p>{{ block.settings.card_text }}</p>
            </div>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
  {% if section.blocks.size > 1 %}
    <button class="slider-arrow slider-arrow--prev" type="button" data-slider-prev aria-label="Previous slide">←</button>
    <button class="slider-arrow slider-arrow--next" type="button" data-slider-next aria-label="Next slide">→</button>
    <div class="hero-slider__dots" data-slider-dots></div>
  {% endif %}
</section>
{% schema %}
{"name":"Mogachi hero slideshow","max_blocks":5,"settings":[{"type":"range","id":"autoplay","label":"Autoplay seconds","min":3,"max":12,"step":1,"default":6}],"blocks":[{"type":"slide","name":"Food slide","settings":[{"type":"image_picker","id":"image","label":"Food image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"AUTHENTIC GOAN FLAVOURS"},{"type":"text","id":"heading","label":"Heading","default":"The Taste of Traditional Goa"},{"type":"textarea","id":"text","label":"Text","default":"Traditional recipes, bold coastal flavours and the warmth of Goa — brought to your table."},{"type":"text","id":"button_label","label":"Button","default":"Shop Goan Specialties"},{"type":"url","id":"button_link","label":"Button link"},{"type":"text","id":"secondary_label","label":"Secondary link","default":"Our story"},{"type":"url","id":"secondary_link","label":"Secondary link URL"},{"type":"text","id":"card_kicker","label":"Floating card kicker","default":"FROM GOA, WITH LOVE"},{"type":"text","id":"card_title","label":"Floating card title","default":"Traditional. Local. Delicious."},{"type":"textarea","id":"card_text","label":"Floating card text","default":"Use this space for a genuine brand promise or product highlight."}]}],"presets":[{"name":"Mogachi hero slideshow","blocks":[{"type":"slide"},{"type":"slide","settings":{"eyebrow":"GOAN KITCHEN FAVOURITES","heading":"Bring Home a Taste of Goa","text":"Discover masalas, pickles, sweets and traditional favourites made for everyday celebrations.","button_label":"Explore the collection"}},{"type":"slide","settings":{"eyebrow":"GIFT THE FLAVOURS","heading":"A Little Goa in Every Box","text":"Create a beautiful food gift for family, friends and anyone who misses the coast.","button_label":"Explore gifts"}}]}]}
{% endschema %}
