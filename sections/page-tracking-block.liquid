<section class="section mr-tracking"><div class="container"><div class="eyebrow">ORDER SUPPORT</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p><div class="mr-tracking__box"><label>Order number<input type="text" placeholder="Enter your order number"></label><label>Email<input type="email" placeholder="Enter your order email"></label><button class="btn" type="button">CHECK ORDER</button></div><small>Connect this interface to your actual order tracking system or carrier service before launch.</small></div></section>
{% schema %}
{
  "name": "Order tracking",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Track your order"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Use your order details to find the latest delivery information."
    }
  ],
  "presets": [
    {
      "name": "Order tracking"
    }
  ]
}
{% endschema %}
