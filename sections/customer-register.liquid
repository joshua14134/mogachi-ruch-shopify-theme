<section class="mr-register-page">
  <div class="mr-register-shell">

    <a class="mr-register-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      <span>MOGACHI</span>
      <small>RUCH</small>
    </a>

    <div class="mr-register-card">

      <div class="mr-register-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="3.5"></circle>
          <path d="M5.5 20c.8-3.6 3-5.4 6.5-5.4s5.7 1.8 6.5 5.4"></path>
          <path d="M19 5v5"></path>
          <path d="M16.5 7.5h5"></path>
        </svg>
      </div>

      <span class="mr-register-eyebrow">
        CUSTOMER ACCOUNT
      </span>

      <h1>Create Your Account</h1>

      <p class="mr-register-intro">
        Join Mogachi Ruch and keep your favourite Goan flavours close.
      </p>

      {% form 'create_customer', novalidate: 'novalidate' %}

        {% if form.errors %}
          <div class="mr-register-message mr-register-message--error" role="alert">
            <strong>We couldn't create your account.</strong>
            <div>{{ form.errors | default_errors }}</div>
          </div>
        {% endif %}

        <div class="mr-register-row">

          <div class="mr-register-field">
            <label for="FirstName">
              First Name
            </label>

            <input
              id="FirstName"
              type="text"
              name="customer[first_name]"
              autocomplete="given-name"
              placeholder="First name"
              value="{{ form.first_name | escape }}"
              required
            >
          </div>

          <div class="mr-register-field">
            <label for="LastName">
              Last Name
            </label>

            <input
              id="LastName"
              type="text"
              name="customer[last_name]"
              autocomplete="family-name"
              placeholder="Last name"
              value="{{ form.last_name | escape }}"
              required
            >
          </div>

        </div>

        <div class="mr-register-field">
          <label for="RegisterEmail">
            Email Address
          </label>

          <input
            id="RegisterEmail"
            type="email"
            name="customer[email]"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            placeholder="Enter your email address"
            value="{{ form.email | escape }}"
            required
          >
        </div>

        <div class="mr-register-field">

          <label for="RegisterPassword">
            Password
          </label>

          <div class="mr-register-password">

            <input
              id="RegisterPassword"
              type="password"
              name="customer[password]"
              autocomplete="new-password"
              placeholder="Create a password"
              required
            >

            <button
              type="button"
              class="mr-register-password-toggle"
              data-register-password-toggle
              aria-label="Show password"
              aria-pressed="false"
            >
              <svg class="mr-register-eye mr-register-eye--open" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"></path>
                <circle cx="12" cy="12" r="2.5"></circle>
              </svg>

              <svg class="mr-register-eye mr-register-eye--closed" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 3l18 18"></path>
                <path d="M10.6 6.2A10.8 10.8 0 0 1 12 6c6 0 9.5 6 9.5 6a18.7 18.7 0 0 1-3.2 3.8"></path>
                <path d="M6.2 6.7C3.8 8.4 2.5 12 2.5 12s3.5 6 9.5 6c1.5 0 2.8-.3 4-.8"></path>
                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path>
              </svg>
            </button>

          </div>

        </div>

        <div class="mr-register-note">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M8.5 12l2.3 2.3 4.7-5"></path>
          </svg>

          <p>
            Your account lets you view orders and save delivery addresses.
          </p>
        </div>

        <button
          type="submit"
          class="mr-register-button"
        >
          <span>Create Account</span>

          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h13"></path>
            <path d="M13 6l6 6-6 6"></path>
          </svg>
        </button>

      {% endform %}

      <div class="mr-register-divider">
        <span>ALREADY A CUSTOMER?</span>
      </div>

      <a
        href="{{ routes.account_login_url }}"
        class="mr-register-login-button"
      >
        <span>Sign In</span>

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h13"></path>
          <path d="M13 6l6 6-6 6"></path>
        </svg>
      </a>

    </div>

    <div class="mr-register-benefits">

      <div class="mr-register-benefit">
        <span>01</span>

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 6.5h16v12H4z"></path>
          <path d="M8 6.5V4h8v2.5"></path>
          <path d="M8 12h8"></path>
          <path d="M8 15h5"></path>
        </svg>

        <p>Track orders</p>
      </div>

      <div class="mr-register-benefit">
        <span>02</span>

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 21s-7-4.4-7-10V5.5L12 3l7 2.5V11c0 5.6-7 10-7 10z"></path>
          <path d="M8.5 12l2.2 2.2 4.8-5"></path>
        </svg>

        <p>Save addresses</p>
      </div>

      <div class="mr-register-benefit">
        <span>03</span>

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 5h16v14H4z"></path>
          <path d="M4 8h16"></path>
          <path d="M8 12h3"></path>
          <path d="M8 15h6"></path>
        </svg>

        <p>Faster checkout</p>
      </div>

    </div>

    <div class="mr-register-footer">
      <a href="{{ routes.root_url }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 12H5"></path>
          <path d="M11 18l-6-6 6-6"></path>
        </svg>

        <span>Back to Mogachi Ruch</span>
      </a>
    </div>

  </div>
</section>

<style>
.mr-register-page {
  min-height: calc(100vh - 76px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 70px 20px 85px;
  box-sizing: border-box;
  background: #f8f4ec;
  color: #17351f;
}

.mr-register-shell {
  width: 100%;
  max-width: 560px;
  margin: 0 auto;
}

.mr-register-brand {
  width: fit-content;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 auto 28px;
  color: #17351f !important;
  text-decoration: none !important;
  line-height: .85;
}

.mr-register-brand span {
  font-size: 25px;
  font-weight: 900;
  letter-spacing: .16em;
}

.mr-register-brand small {
  margin-top: 7px;
  color: #b47a2a;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .38em;
}

.mr-register-card {
  padding: 42px;
  background: #fff;
  border: 1px solid #e3ddd1;
  box-shadow: 0 22px 60px rgba(23,53,31,.08);
}

.mr-register-icon {
  width: 54px;
  height: 54px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
  background: #edf1e9;
  color: #17351f;
}

.mr-register-icon svg {
  width: 24px;
  height: 24px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.mr-register-eyebrow {
  display: block;
  margin-bottom: 9px;
  color: #8a5c4c;
  text-align: center;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .2em;
}

.mr-register-card h1 {
  margin: 0;
  color: #17351f;
  text-align: center;
  font-size: 35px;
  line-height: 1.1;
  letter-spacing: -.025em;
}

.mr-register-intro {
  max-width: 390px;
  margin: 13px auto 30px;
  color: #707970;
  text-align: center;
  font-size: 13px;
  line-height: 1.7;
}

.mr-register-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 15px;
}

.mr-register-field {
  margin-bottom: 19px;
}

.mr-register-field label {
  display: block;
  margin-bottom: 8px;
  color: #17351f;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .05em;
}

.mr-register-field input {
  width: 100%;
  min-height: 51px;
  box-sizing: border-box;
  padding: 0 14px;
  background: #fffdf9;
  border: 1px solid #dcd5c9;
  border-radius: 0;
  color: #17351f;
  font-family: inherit;
  font-size: 13px;
  outline: none;
  transition: border-color .2s ease, box-shadow .2s ease;
}

.mr-register-field input::placeholder {
  color: #9b9f99;
}

.mr-register-field input:hover {
  border-color: #bdb6a9;
}

.mr-register-field input:focus {
  border-color: #2f7d32;
  box-shadow: 0 0 0 3px rgba(47,125,50,.08);
}

.mr-register-field input:invalid:not(:placeholder-shown) {
  border-color: #c98b7c;
}

.mr-register-password {
  position: relative;
}

.mr-register-password input {
  padding-right: 52px;
}

.mr-register-password-toggle {
  position: absolute;
  top: 50%;
  right: 6px;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transform: translateY(-50%);
  background: transparent;
  border: 0;
  color: #6e776f;
  cursor: pointer;
}

.mr-register-password-toggle svg {
  width: 19px;
  height: 19px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.mr-register-eye--closed {
  display: none;
}

.mr-register-password-toggle.is-visible .mr-register-eye--open {
  display: none;
}

.mr-register-password-toggle.is-visible .mr-register-eye--closed {
  display: block;
}

.mr-register-password-toggle:hover {
  color: #17351f;
}

.mr-register-message {
  margin-bottom: 20px;
  padding: 13px 15px;
  font-size: 12px;
  line-height: 1.55;
}

.mr-register-message--error {
  background: #fbefeb;
  border: 1px solid #e3c5bc;
  color: #8a3f31;
}

.mr-register-message strong {
  display: block;
  margin-bottom: 4px;
}

.mr-register-message ul {
  margin: 6px 0 0;
  padding-left: 17px;
}

.mr-register-note {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 2px 0 20px;
  padding: 12px 13px;
  background: #f4f6f0;
  color: #687269;
  font-size: 10px;
  line-height: 1.55;
}

.mr-register-note svg {
  flex: 0 0 auto;
  width: 16px;
  height: 16px;
  margin-top: 1px;
  fill: none;
  stroke: #2f7d32;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.mr-register-note p {
  margin: 0;
}

.mr-register-button {
  width: 100%;
  min-height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding: 0 20px;
  background: #17351f;
  border: 0;
  border-radius: 0;
  color: #fff;
  font-family: inherit;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .12em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background .2s ease, transform .2s ease;
}

.mr-register-button:hover {
  background: #2f7d32;
  transform: translateY(-1px);
}

.mr-register-button:focus-visible {
  outline: 2px solid #b47a2a;
  outline-offset: 3px;
}

.mr-register-button svg {
  width: 17px;
  height: 17px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.mr-register-divider {
  display: flex;
  align-items: center;
  gap: 13px;
  margin: 29px 0 18px;
}

.mr-register-divider::before,
.mr-register-divider::after {
  content: "";
  height: 1px;
  flex: 1;
  background: #e8e2d7;
}

.mr-register-divider span {
  color: #9a978f;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .13em;
  white-space: nowrap;
}

.mr-register-login-button {
  min-height: 49px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13px;
  box-sizing: border-box;
  border: 1px solid #d8d0c3;
  color: #17351f !important;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .1em;
  text-decoration: none !important;
  text-transform: uppercase;
  transition: background .2s ease, border-color .2s ease;
}

.mr-register-login-button:hover {
  background: #f7f3eb;
  border-color: #17351f;
}

.mr-register-login-button svg {
  width: 17px;
  height: 17px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.mr-register-benefits {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin-top: 18px;
  border-top: 1px solid #ded7ca;
  border-bottom: 1px solid #ded7ca;
}

.mr-register-benefit {
  padding: 16px 10px 15px;
  text-align: center;
}

.mr-register-benefit + .mr-register-benefit {
  border-left: 1px solid #ded7ca;
}

.mr-register-benefit > span {
  display: block;
  margin-bottom: 7px;
  color: #8a5c4c;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .1em;
}

.mr-register-benefit svg {
  width: 19px;
  height: 19px;
  margin-bottom: 7px;
  fill: none;
  stroke: #17351f;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.mr-register-benefit p {
  margin: 0;
  color: #687269;
  font-size: 9px;
  line-height: 1.4;
}

.mr-register-footer {
  margin-top: 24px;
  text-align: center;
}

.mr-register-footer a {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #687269;
  font-size: 11px;
  font-weight: 700;
  text-decoration: none;
}

.mr-register-footer a:hover {
  color: #2f7d32;
}

.mr-register-footer svg {
  width: 16px;
  height: 16px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

@media screen and (max-width: 600px) {
  .mr-register-page {
    min-height: auto;
    padding: 45px 15px 60px;
  }

  .mr-register-card {
    padding: 32px 21px;
  }

  .mr-register-card h1 {
    font-size: 30px;
  }

  .mr-register-intro {
    margin-bottom: 25px;
  }

  .mr-register-row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .mr-register-benefit {
    padding: 14px 6px;
  }

  .mr-register-benefit p {
    font-size: 8px;
  }
}

@media screen and (max-width: 390px) {
  .mr-register-card {
    padding: 28px 17px;
  }

  .mr-register-benefits {
    display: block;
  }

  .mr-register-benefit {
    display: grid;
    grid-template-columns: 25px 24px 1fr;
    align-items: center;
    gap: 8px;
    text-align: left;
  }

  .mr-register-benefit + .mr-register-benefit {
    border-left: 0;
    border-top: 1px solid #ded7ca;
  }

  .mr-register-benefit > span,
  .mr-register-benefit svg {
    margin: 0;
  }
}
</style>

<script>
(function() {
  var toggle = document.querySelector('[data-register-password-toggle]');
  var password = document.getElementById('RegisterPassword');

  if (!toggle || !password) {
    return;
  }

  toggle.addEventListener('click', function() {
    var isHidden = password.type === 'password';

    password.type = isHidden ? 'text' : 'password';

    toggle.classList.toggle('is-visible', isHidden);

    toggle.setAttribute(
      'aria-pressed',
      isHidden ? 'true' : 'false'
    );

    toggle.setAttribute(
      'aria-label',
      isHidden ? 'Hide password' : 'Show password'
    );
  });
})();
</script>

{% schema %}
{
  "name": "Customer register",
  "settings": []
}
{% endschema %}