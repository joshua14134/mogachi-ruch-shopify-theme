<section class="mr-auth-page">
  <div class="mr-auth-shell">

    <a class="mr-auth-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      <span>MOGACHI</span>
      <small>RUCH</small>
    </a>

    <div class="mr-auth-card">

      <div class="mr-auth-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="8" r="3.5"></circle>
          <path d="M5.5 20c.8-3.6 3-5.4 6.5-5.4s5.7 1.8 6.5 5.4"></path>
        </svg>
      </div>

      <span class="mr-auth-eyebrow">CUSTOMER ACCOUNT</span>

      <h1>Welcome Back</h1>

      <p class="mr-auth-intro">
        Sign in to view your orders, manage your addresses and continue shopping with Mogachi Ruch.
      </p>

      {% form 'customer_login', novalidate: 'novalidate' %}

        {% if form.errors %}
          <div class="mr-auth-message mr-auth-message--error" role="alert">
            <strong>We couldn't sign you in.</strong>
            <div>{{ form.errors | default_errors }}</div>
          </div>
        {% endif %}

        <div class="mr-field">
          <label for="CustomerEmail">Email Address</label>

          <input
            id="CustomerEmail"
            type="email"
            name="customer[email]"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            placeholder="Enter your email address"
            value="{{ form.email | escape }}"
            required
          >
        </div>

        <div class="mr-field">
          <div class="mr-password-heading">
            <label for="CustomerPassword">Password</label>

            <a href="#recover" data-recover-open>
              Forgot password?
            </a>
          </div>

          <div class="mr-password-input">
            <input
              id="CustomerPassword"
              type="password"
              name="customer[password]"
              autocomplete="current-password"
              placeholder="Enter your password"
              required
            >

            <button
              type="button"
              class="mr-password-toggle"
              data-password-toggle
              aria-label="Show password"
              aria-pressed="false"
            >
              <svg class="mr-eye mr-eye--open" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"></path>
                <circle cx="12" cy="12" r="2.5"></circle>
              </svg>

              <svg class="mr-eye mr-eye--closed" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 3l18 18"></path>
                <path d="M10.6 6.2A10.8 10.8 0 0 1 12 6c6 0 9.5 6 9.5 6a18.7 18.7 0 0 1-3.2 3.8"></path>
                <path d="M6.2 6.7C3.8 8.4 2.5 12 2.5 12s3.5 6 9.5 6c1.5 0 2.8-.3 4-.8"></path>
                <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="mr-auth-primary">
          <span>Sign In</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h13"></path>
            <path d="M13 6l6 6-6 6"></path>
          </svg>
        </button>

      {% endform %}

      <div class="mr-auth-divider">
        <span>NEW TO MOGACHI RUCH?</span>
      </div>

      <a
        href="{{ routes.account_register_url }}"
        class="mr-create-account"
      >
        <span>Create Your Account</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h13"></path>
          <path d="M13 6l6 6-6 6"></path>
        </svg>
      </a>

    </div>

    <div class="mr-auth-benefits">

      <div class="mr-benefit">
        <span class="mr-benefit-number">01</span>

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 6.5h16v12H4z"></path>
          <path d="M8 6.5V4h8v2.5"></path>
          <path d="M8 12h8"></path>
          <path d="M8 15h5"></path>
        </svg>

        <p>Track your orders</p>
      </div>

      <div class="mr-benefit">
        <span class="mr-benefit-number">02</span>

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 21s-7-4.4-7-10V5.5L12 3l7 2.5V11c0 5.6-7 10-7 10z"></path>
          <path d="M8.5 12l2.2 2.2 4.8-5"></path>
        </svg>

        <p>Save your addresses</p>
      </div>

      <div class="mr-benefit">
        <span class="mr-benefit-number">03</span>

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 5h16v14H4z"></path>
          <path d="M4 8h16"></path>
          <path d="M8 12h3"></path>
          <path d="M8 15h6"></path>
        </svg>

        <p>Checkout faster</p>
      </div>

    </div>

    <div class="mr-auth-footer">
      <a href="{{ routes.root_url }}">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 12H5"></path>
          <path d="M11 18l-6-6 6-6"></path>
        </svg>
        <span>Back to Mogachi Ruch</span>
      </a>
    </div>

  </div>
</section>

<div
  id="recover"
  class="mr-recover-overlay"
  data-recover
  aria-hidden="true"
>
  <div
    class="mr-recover-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="RecoverTitle"
  >

    <button
      type="button"
      class="mr-recover-close"
      data-recover-close
      aria-label="Close password recovery"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12"></path>
        <path d="M18 6L6 18"></path>
      </svg>
    </button>

    <div class="mr-recover-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <path d="M4 7h16v12H4z"></path>
        <path d="M4 8l8 6 8-6"></path>
      </svg>
    </div>

    <span class="mr-auth-eyebrow mr-auth-eyebrow--left">
      ACCOUNT RECOVERY
    </span>

    <h2 id="RecoverTitle">Reset Password</h2>

    <p>
      Enter the email address connected to your account and we'll send you instructions to reset your password.
    </p>

    {% form 'recover_customer_password' %}

      {% if form.posted_successfully? %}
        <div class="mr-auth-message mr-auth-message--success" role="status">
          Password reset instructions have been sent to your email.
        </div>
      {% endif %}

      {% if form.errors %}
        <div class="mr-auth-message mr-auth-message--error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {% endif %}

      <div class="mr-field">
        <label for="RecoverEmail">Email Address</label>

        <input
          id="RecoverEmail"
          type="email"
          name="email"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          placeholder="Enter your email address"
          required
        >
      </div>

      <button type="submit" class="mr-auth-primary">
        <span>Send Instructions</span>

        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h13"></path>
          <path d="M13 6l6 6-6 6"></path>
        </svg>
      </button>

    {% endform %}

    <button
      type="button"
      class="mr-recover-back"
      data-recover-close
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M19 12H5"></path>
        <path d="M11 18l-6-6 6-6"></path>
      </svg>

      <span>Back to Sign In</span>
    </button>

  </div>
</div>

