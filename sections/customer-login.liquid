<script>
(function() {
  var page = document.querySelector('.mr-auth-page');
  var password = document.getElementById('CustomerPassword');
  var toggle = document.querySelector('[data-password-toggle]');
  var recover = document.querySelector('[data-recover]');
  var recoverOpen = document.querySelector('[data-recover-open]');
  var recoverCloseButtons = document.querySelectorAll('[data-recover-close]');

  function openRecovery() {
    if (!recover) return;

    recover.classList.add('is-open');
    recover.setAttribute('aria-hidden', 'false');
    document.body.classList.add('mr-recover-active');

    var email = document.getElementById('RecoverEmail');

    if (email) {
      window.setTimeout(function() {
        email.focus();
      }, 100);
    }
  }

  function closeRecovery() {
    if (!recover) return;

    recover.classList.remove('is-open');
    recover.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('mr-recover-active');

    if (window.location.hash === '#recover') {
      history.replaceState(null, '', window.location.pathname + window.location.search);
    }
  }

  if (password && toggle) {
    toggle.addEventListener('click', function() {
      var isHidden = password.type === 'password';

      password.type = isHidden ? 'text' : 'password';

      toggle.classList.toggle('is-visible', isHidden);
      toggle.setAttribute('aria-pressed', isHidden ? 'true' : 'false');
      toggle.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
    });
  }

  if (recoverOpen) {
    recoverOpen.addEventListener('click', function(event) {
      event.preventDefault();
      openRecovery();
    });
  }

  recoverCloseButtons.forEach(function(button) {
    button.addEventListener('click', function(event) {
      event.preventDefault();
      closeRecovery();
    });
  });

  if (recover) {
    recover.addEventListener('click', function(event) {
      if (event.target === recover) {
        closeRecovery();
      }
    });
  }

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape' && recover && recover.classList.contains('is-open')) {
      closeRecovery();
    }
  });

  if (window.location.hash === '#recover') {
    openRecovery();
  }
})();
</script>

