<section class="section mr-page-cta"><div class="container"><div class="mr-cta-box"><div><div class="eyebrow">MOGACHI RUCH</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>{% if section.settings.url != blank %}<a class="btn" href="{{ section.settings.url }}">{{ section.settings.label }}</a>{% endif %}</div></div></section>{% schema %}{"name":"Page CTA","settings":[{"type":"text","id":"heading","label":"Heading","default":"Bring Goa to your table"},{"type":"textarea","id":"text","label":"Text","default":"Explore the collection and discover traditional flavours made for sharing."},{"type":"text","id":"label","label":"Button label","default":"SHOP NOW"},{"type":"url","id":"url","label":"Button link"}]}{% endschema %}