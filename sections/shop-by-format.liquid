<section class="mr-format section-pad">
  <div class="page-width">
    <div class="section-head"><div><span class="eyebrow">SHOP THE WAY YOU LIKE</span><h2>{{ section.settings.heading }}</h2></div><p>{{ section.settings.text }}</p></div>
    <div class="format-grid">
      {% for block in section.blocks %}
        <a class="format-card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <div class="format-media">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}{% else %}{% case forloop.index %}{% when 1 %}{% assign fallback = 'goan-masalas.svg' %}{% when 2 %}{% assign fallback = 'goan-pickles.svg' %}{% when 3 %}{% assign fallback = 'goan-sweets.svg' %}{% else %}{% assign fallback = 'goan-gifts.svg' %}{% endcase %}<img src="{{ fallback | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="900" height="900">{% endif %}</div>
          <div class="format-body"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p><span>EXPLORE →</span></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{"name":"Shop by format","settings":[{"type":"text","id":"heading","label":"Heading","default":"From everyday jars to special gift boxes"},{"type":"textarea","id":"text","label":"Intro","default":"Create your own assortment with the formats and collections that suit your table."}],"blocks":[{"type":"format","name":"Format","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"icon","label":"Placeholder icon","default":"🍲"},{"type":"text","id":"title","label":"Title","default":"Traditional Jars"},{"type":"textarea","id":"text","label":"Description","default":"Authentic Goan favourites, packed with care."},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Shop by format","blocks":[{"type":"format","settings":{"title":"Masala Packs","text":"Everyday Goan spice blends."}},{"type":"format","settings":{"title":"Pickle Jars","text":"Bold, traditional flavours."}},{"type":"format","settings":{"title":"Sweet Boxes","text":"Goan sweets for every occasion."}},{"type":"format","settings":{"title":"Gift Boxes","text":"A taste of Goa, beautifully packed."}}]}]}
{% endschema %}
