<section class="hero">
  <div class="hero__media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', alt: section.settings.heading }}
    {% endif %}
  </div>
  <div class="hero__overlay"></div>
  <div class="container">
    <div class="hero__content">
      {% if section.settings.eyebrow != blank %}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.text }}</p>
      <div class="hero__actions">
        {% if section.settings.button_label != blank %}<a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{% endif %}
        {% if section.settings.button2_label != blank %}<a class="btn btn--light" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>{% endif %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Hero","settings":[
{"type":"image_picker","id":"image","label":"Hero image"},
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"AUTHENTIC GOAN FLAVOURS"},
{"type":"text","id":"heading","label":"Heading","default":"The Taste of Traditional Goa"},
{"type":"textarea","id":"text","label":"Text","default":"Authentic flavours, traditional recipes and the taste of Goa — brought to your table."},
{"type":"text","id":"button_label","label":"Primary button","default":"Shop Now"},
{"type":"url","id":"button_link","label":"Primary link"},
{"type":"text","id":"button2_label","label":"Secondary button","default":"Explore Goan Flavours"},
{"type":"url","id":"button2_link","label":"Secondary link"}
],"presets":[{"name":"Hero"}]}
{% endschema %}
