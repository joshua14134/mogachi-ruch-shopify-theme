<section class="section newsletter">
  <div class="container newsletter-inner">
    <div><div class="eyebrow" style="color:#fff">{{ section.settings.eyebrow }}</div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></div>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div style="display:flex;gap:8px;width:100%"><input type="email" name="contact[email]" placeholder="Your email address" required><button class="btn" type="submit" style="background:#fff;color:var(--accent2);border-color:#fff">Subscribe</button></div>
    {% endform %}
  </div>
</section>
{% schema %}
{"name":"Newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"STAY CONNECTED"},{"type":"text","id":"heading","label":"Heading","default":"Bring Goan flavours home"},{"type":"textarea","id":"text","label":"Text","default":"Sign up for new products, special offers and stories from Goa."}],"presets":[{"name":"Newsletter"}]}
{% endschema %}
