<section class="section">
  <div class="container">

    <div class="section__heading">
      {% if section.settings.eyebrow != blank %}
        <div class="eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}

      <h2>{{ section.settings.heading }}</h2>

      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}
    </div>

    {% assign collection = section.settings.collection %}

    {% if collection != blank %}

      <div class="product-grid">

        {% for product in collection.products limit: section.settings.products_to_show %}

          <a class="card" href="{{ product.url }}">

            <div class="product-media">

              {% if product.featured_image %}

                {{
                  product.featured_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '450,600,750,900',
                    sizes: '(max-width: 600px) 92vw, (max-width: 900px) 45vw, 22vw',
                    alt: product.title
                }}

              {% else %}

                <div class="placeholder">
                  Mogachi Ruch
                </div>

              {% endif %}

            </div>

            <div class="card__body">

              <h3 class="card__title">
                {{ product.title }}
              </h3>

              <p class="card__text">
                {{ product.description | strip_html | truncate: 80 }}
              </p>

              <div class="price">
                {{ product.price | money }}
              </div>

            </div>

          </a>

        {% endfor %}

      </div>

    {% else %}

      {% assign masala_collection = collections['goan-masalas'] %}
      {% assign pickle_collection = collections['goan-pickles'] %}
      {% assign sweets_collection = collections['goan-sweets'] %}
      {% assign snacks_collection = collections['traditional-snacks'] %}

      <div class="grid grid--4">

        <a
          class="card"
          href="{% if masala_collection != blank %}{{ masala_collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
        >

          <div class="product-media">

            {% if section.settings.masala_image != blank %}

              {{
                section.settings.masala_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '450,600,750,900',
                  sizes: '(max-width: 600px) 92vw, (max-width: 900px) 45vw, 22vw',
                  alt: 'Goan Masalas'
              }}

            {% else %}

              <img
                src="{{ 'goan-masalas.svg' | asset_url }}"
                alt="Goan Masalas"
                loading="lazy"
                width="900"
                height="900"
              >

            {% endif %}

          </div>

          <div class="card__body">

            <h3 class="card__title">
              Goan Masalas
            </h3>

            <p class="card__text">
              Bold spice blends inspired by Goan kitchens.
            </p>

            <div class="price">
              Explore collection
            </div>

          </div>

        </a>


        <a
          class="card"
          href="{% if pickle_collection != blank %}{{ pickle_collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
        >

          <div class="product-media">

            {% if section.settings.pickle_image != blank %}

              {{
                section.settings.pickle_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '450,600,750,900',
                  sizes: '(max-width: 600px) 92vw, (max-width: 900px) 45vw, 22vw',
                  alt: 'Goan Pickles'
              }}

            {% else %}

              <img
                src="{{ 'goan-pickles.svg' | asset_url }}"
                alt="Goan Pickles"
                loading="lazy"
                width="900"
                height="900"
              >

            {% endif %}

          </div>

          <div class="card__body">

            <h3 class="card__title">
              Goan Pickles
            </h3>

            <p class="card__text">
              Tangy accompaniments for everyday meals.
            </p>

            <div class="price">
              Explore collection
            </div>

          </div>

        </a>


        <a
          class="card"
          href="{% if sweets_collection != blank %}{{ sweets_collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
        >

          <div class="product-media">

            {% if section.settings.sweets_image != blank %}

              {{
                section.settings.sweets_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '450,600,750,900',
                  sizes: '(max-width: 600px) 92vw, (max-width: 900px) 45vw, 22vw',
                  alt: 'Goan Sweets'
              }}

            {% else %}

              <img
                src="{{ 'goan-sweets.svg' | asset_url }}"
                alt="Goan Sweets"
                loading="lazy"
                width="900"
                height="900"
              >

            {% endif %}

          </div>

          <div class="card__body">

            <h3 class="card__title">
              Goan Sweets
            </h3>

            <p class="card__text">
              Sweet traditions made for sharing.
            </p>

            <div class="price">
              Explore collection
            </div>

          </div>

        </a>


        <a
          class="card"
          href="{% if snacks_collection != blank %}{{ snacks_collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
        >

          <div class="product-media">

            {% if section.settings.snacks_image != blank %}

              {{
                section.settings.snacks_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '450,600,750,900',
                  sizes: '(max-width: 600px) 92vw, (max-width: 900px) 45vw, 22vw',
                  alt: 'Traditional Snacks'
              }}

            {% else %}

              <img
                src="{{ 'goan-flavours.svg' | asset_url }}"
                alt="Traditional Snacks"
                loading="lazy"
                width="900"
                height="900"
              >

            {% endif %}

          </div>

          <div class="card__body">

            <h3 class="card__title">
              Traditional Snacks
            </h3>

            <p class="card__text">
              Comforting snack-time favourites.
            </p>

            <div class="price">
              Explore collection
            </div>

          </div>

        </a>

      </div>

    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "GOAN FAVOURITES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Our Goan Specialties"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover masalas, pickles, sweets, snacks and traditional favourites."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Category Images"
    },
    {
      "type": "image_picker",
      "id": "masala_image",
      "label": "Goan Masalas Image"
    },
    {
      "type": "image_picker",
      "id": "pickle_image",
      "label": "Goan Pickles Image"
    },
    {
      "type": "image_picker",
      "id": "sweets_image",
      "label": "Goan Sweets Image"
    },
    {
      "type": "image_picker",
      "id": "snacks_image",
      "label": "Traditional Snacks Image"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}