<section class="section section--tight icon-features">
  <div class="container icon-features-grid">
    {% for block in section.blocks %}
      <div class="icon-feature" {{ block.shopify_attributes }}>
        <div class="icon-feature__icon">{{ block.settings.icon }}</div>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Icon features","max_blocks":5,"blocks":[{"type":"feature","name":"Feature","settings":[
{"type":"text","id":"icon","label":"Icon","default":"✦"},
{"type":"text","id":"title","label":"Title","default":"Carefully Packed"},
{"type":"textarea","id":"text","label":"Text","default":"Prepared and packed with care."}]}],
"presets":[{"name":"Icon features","blocks":[
{"type":"feature","settings":{"icon":"✦","title":"AUTHENTIC RECIPES","text":"Inspired by Goan food traditions."}},
{"type":"feature","settings":{"icon":"◈","title":"QUALITY INGREDIENTS","text":"Use your verified sourcing story here."}},
{"type":"feature","settings":{"icon":"◇","title":"CAREFULLY PACKED","text":"Prepared and packed with care."}},
{"type":"feature","settings":{"icon":"✓","title":"SECURE SHOPPING","text":"Secure checkout through Shopify."}}
]}]}
{% endschema %}
