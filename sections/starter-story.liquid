<section class="mr-starter-story">

  <div class="mr-starter-story__image">
    {% if section.settings.story_image != blank %}
      {{ section.settings.story_image | image_url: width: 1400 | image_tag: alt: 'Traditional Goan food and heritage', loading: 'lazy' }}
    {% else %}
      <div class="mr-starter-story__placeholder">
        Traditional Goan food and heritage
      </div>
    {% endif %}
  </div>

  <div class="mr-starter-story__copy">
    <span class="mr-starter-kicker">A SMALL GOAN BEGINNING</span>

    <h2>From our kitchen to yours.</h2>

    <p>
      Mogachi Ruch starts with a simple idea: keep a few traditional Goan favourites close to home and share them with more people.
    </p>

    <p>
      We are starting small, focusing on flavour, care and honest products rather than a huge catalogue.
    </p>

    <a href="/pages/About-Us">ABOUT US</a>
  </div>

</section>

<style>
.mr-starter-story{
  width:100%;
  display:grid;
  grid-template-columns:1fr 1fr;
  background:#f8f5ef;
  overflow:hidden;
}

.mr-starter-story__image{
  width:100%;
  min-height:560px;
  overflow:hidden;
  background:#e8e0d2;
}

.mr-starter-story__image img{
  display:block;
  width:100%;
  height:100%;
  min-height:560px;
  object-fit:cover;
}

.mr-starter-story__placeholder{
  width:100%;
  height:100%;
  min-height:560px;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:30px;
  text-align:center;
  color:#6e7d62;
  font-size:18px;
  font-weight:700;
}

.mr-starter-story__copy{
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:70px clamp(35px,6vw,100px);
  background:#f8f5ef;
}

.mr-starter-story__copy .mr-starter-kicker{
  display:block;
  margin-bottom:14px;
  color:#6e7d62;
  font-size:11px;
  font-weight:800;
  letter-spacing:.2em;
}

.mr-starter-story__copy h2{
  margin:0 0 22px;
  color:#3b2e24;
  font-size:clamp(34px,4vw,58px);
  line-height:1.05;
  font-weight:700;
}

.mr-starter-story__copy p{
  max-width:560px;
  margin:0 0 16px;
  color:#756b61;
  font-size:16px;
  line-height:1.8;
}

.mr-starter-story__copy a{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:max-content;
  margin-top:18px;
  padding:15px 28px;
  background:#17351f;
  color:#fff!important;
  text-decoration:none!important;
  font-size:12px;
  font-weight:800;
  letter-spacing:.12em;
  transition:background .25s ease,transform .25s ease;
}

.mr-starter-story__copy a:hover{
  background:#2f7d32;
  transform:translateY(-2px);
}

@media screen and (max-width:900px){
  .mr-starter-story{
    grid-template-columns:1fr;
  }

  .mr-starter-story__image,
  .mr-starter-story__image img,
  .mr-starter-story__placeholder{
    min-height:420px;
  }

  .mr-starter-story__copy{
    padding:55px 30px 65px;
  }
}

@media screen and (max-width:600px){
  .mr-starter-story__image,
  .mr-starter-story__image img,
  .mr-starter-story__placeholder{
    min-height:330px;
  }

  .mr-starter-story__copy{
    padding:45px 22px 55px;
  }

  .mr-starter-story__copy h2{
    font-size:34px;
  }

  .mr-starter-story__copy p{
    font-size:14px;
    line-height:1.7;
  }
}
</style>

{% schema %}
{
  "name": "Starter story",
  "settings": [
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story image"
    }
  ],
  "presets": [
    {
      "name": "Starter story"
    }
  ]
}
{% endschema %}