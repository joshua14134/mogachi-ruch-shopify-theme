<section class="pr-hero">
  {% if section.settings.image != blank %}
    {{ section.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', widths: '900,1200,1600,2000,2200', sizes: '100vw', alt: section.settings.heading }}
  {% else %}
    <img src="{{ 'goan-story.svg' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="eager" width="2200" height="1200">
  {% endif %}

  <div class="pr-hero__shade"></div>

  <div class="pr-hero__copy">
    {% if section.settings.eyebrow != blank %}
      <span class="pr-kicker">{{ section.settings.eyebrow }}</span>
    {% endif %}

    <h1>{{ section.settings.heading }}</h1>

    {% if section.settings.text != blank %}
      <p>{{ section.settings.text }}</p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <a class="pr-pill" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

<style>
.pr-hero{
  position:relative;
  width:100%;
  height:500px;
  min-height:500px;
  overflow:hidden;
  background:#3b2e24;
}

.pr-hero > img{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
}

.pr-hero__shade{
  position:absolute;
  inset:0;
  background:
    linear-gradient(
      90deg,
      rgba(25,30,22,.68) 0%,
      rgba(25,30,22,.42) 42%,
      rgba(25,30,22,.12) 75%,
      rgba(25,30,22,.05) 100%
    ),
    linear-gradient(
      0deg,
      rgba(20,25,18,.30) 0%,
      rgba(20,25,18,0) 55%
    );
}

.pr-hero__copy{
  position:absolute;
  z-index:2;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  width:min(680px,calc(100% - 48px));
  text-align:center;
  color:#fff;
}

.pr-kicker{
  display:block;
  margin:0 0 12px;
  color:#e6d7ae!important;
  font-size:10px;
  font-weight:800;
  letter-spacing:.24em;
  line-height:1.2;
  text-transform:uppercase;
  text-shadow:0 2px 12px rgba(0,0,0,.35);
}

.pr-hero__copy h1{
  margin:0;
  color:#fff!important;
  font-family:Georgia,"Times New Roman",serif;
  font-size:clamp(52px,7vw,86px);
  line-height:.92;
  font-weight:400;
  letter-spacing:-.035em;
  text-shadow:0 3px 20px rgba(0,0,0,.35);
}

.pr-hero__copy p{
  max-width:500px;
  margin:16px auto 24px;
  color:#fff!important;
  font-size:15px;
  line-height:1.55;
  font-weight:500;
  text-shadow:0 2px 12px rgba(0,0,0,.4);
}

.pr-pill{
  display:inline-flex!important;
  align-items:center;
  justify-content:center;
  min-width:118px;
  padding:12px 25px;
  background:#f4eee2!important;
  color:#17351f!important;
  border:1px solid #f4eee2!important;
  border-radius:0!important;
  text-decoration:none!important;
  font-size:10px;
  line-height:1;
  font-weight:900;
  letter-spacing:.14em;
  text-transform:uppercase;
  box-shadow:0 8px 25px rgba(0,0,0,.18);
  transition:all .25s ease;
}

.pr-pill:hover{
  background:#17351f!important;
  color:#fff!important;
  border-color:#17351f!important;
  transform:translateY(-2px);
}

@media screen and (max-width:800px){
  .pr-hero{
    height:470px;
    min-height:470px;
  }

  .pr-hero__shade{
    background:
      linear-gradient(
        90deg,
        rgba(25,30,22,.62),
        rgba(25,30,22,.28)
      ),
      linear-gradient(
        0deg,
        rgba(20,25,18,.45),
        rgba(20,25,18,.05) 70%
      );
  }

  .pr-hero__copy{
    width:calc(100% - 40px);
  }

  .pr-kicker{
    margin-bottom:10px;
    font-size:9px;
  }

  .pr-hero__copy h1{
    font-size:58px;
  }

  .pr-hero__copy p{
    max-width:430px;
    margin:14px auto 21px;
    font-size:14px;
  }
}

@media screen and (max-width:600px){
  .pr-hero{
    height:420px;
    min-height:420px;
  }

  .pr-hero__copy{
    width:calc(100% - 32px);
  }

  .pr-kicker{
    margin-bottom:9px;
    font-size:8px;
    letter-spacing:.2em;
  }

  .pr-hero__copy h1{
    font-size:48px;
  }

  .pr-hero__copy p{
    margin:12px auto 18px;
    font-size:13px;
    line-height:1.5;
  }

  .pr-pill{
    min-width:105px;
    padding:11px 20px;
    font-size:9px;
  }
}
</style>

{% schema %}
{
  "name": "Home hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "TRADITIONAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GOA"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Authentic Goan flavours from Mogachi Ruch."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Home hero"
    }
  ]
}
{% endschema %}