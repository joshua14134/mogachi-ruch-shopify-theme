<section class="section"><div class="container" style="max-width:1000px"><div class="section__heading"><div class="eyebrow">MY ACCOUNT</div><h1>{{ order.name }}</h1><p>{{ order.created_at | date: "%d %B %Y" }}</p></div><div class="card"><div class="card__body">{% for line_item in order.line_items %}<div class="order-row"><span>{{ line_item.title }} × {{ line_item.quantity }}</span><span>{{ line_item.final_line_price | money }}</span></div>{% endfor %}<hr><div class="order-row"><strong>Total</strong><strong>{{ order.total_price | money }}</strong></div></div></div><p><a href="{{ routes.account_url }}">← Back to My Account</a></p></div></section>