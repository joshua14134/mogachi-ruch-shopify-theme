<!doctype html><html><head>{{ content_for_header }}{{ 'theme.css' | asset_url | stylesheet_tag }}</head><body><main class="section"><div class="container" style="max-width:560px;text-align:center"><div class="eyebrow">MOGACHI RUCH</div><h1>Gift card</h1><p>Gift card balance</p><div class="card card__body"><h2>{{ gift_card.initial_value | money }}</h2>{% if gift_card.enabled %}<p>Balance: {{ gift_card.balance | money }}</p><p>Code: <strong>{{ gift_card.code | format_code }}</strong></p>{% else %}<p>This gift card is no longer active.</p>{% endif %}</div><a class="btn" href="{{ routes.root_url }}">Continue shopping</a></div></main></body></html>
